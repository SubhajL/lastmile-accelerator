# LMA Development Environment Variables
# Source this file or use with hivemind/foreman
# Points to services running in lma-devstack-compose-gitea4001

# ============================================================================
# Environment
# ============================================================================
ENV=dev
NODE_ENV=development

# ============================================================================
# Service Ports (for reference - each service reads its own)
# ============================================================================
# projects-service: 7002
# observability-service: 7301
# notification-service: 7902
# dep-governance-service: 7106
# db-guardian-service: 7105
# test-lab-service: 7202
# secrets-env-service: 7104

# ============================================================================
# Database
# ============================================================================
DATABASE_URL=postgres://lma:lma@localhost:55432/lma
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=lma
POSTGRES_PASSWORD=lma
POSTGRES_DB=lma

# ============================================================================
# Redis
# ============================================================================
REDIS_URL=redis://localhost:4050
REDIS_HOST=localhost
REDIS_PORT=4050

# ============================================================================
# S3 / MinIO
# ============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Service-specific buckets
SNAPSHOT_BUCKET=snapshots
RESULTS_BUCKET=results
PROJECTS_BUCKET=projects
BACKUP_S3_BUCKET=backups
S3_BUCKET_PROJECTS=projects
S3_BUCKET_REPROS=artifacts

# ============================================================================
# NATS / JetStream
# ============================================================================
NATS_URL=nats://localhost:4222

# ============================================================================
# Vault
# ============================================================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=lma-root
VAULT_ROLE_ID=dev-role-id
VAULT_SECRET_ID=dev-secret-id

# ============================================================================
# Keycloak / OIDC
# ============================================================================
OIDC_ISSUER_URL=http://localhost:8080/realms/lma
JWT_JWKS_URL=http://localhost:8080/realms/lma/protocol/openid-connect/certs
JWT_PUBLIC_KEY=http://localhost:8080/realms/lma/protocol/openid-connect/certs
KEYCLOAK_URL=http://localhost:8080

# ============================================================================
# Observability
# ============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=lma-dev
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200

# ============================================================================
# Email / Notifications
# ============================================================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=dev@lma.local
MAILHOG_URL=http://localhost:8025

# Optional external services (leave empty for mocks)
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SLACK_WEBHOOK_URL=

# ============================================================================
# Git Provider
# ============================================================================
GITEA_URL=http://localhost:4001
SCM_ALLOWED_HOSTS=localhost:4001,gitea:3000

# GitHub (only if you need real GitHub integration)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ============================================================================
# Security Scanning
# ============================================================================
CLAMAV_URL=localhost:3310
GRYPE_DB_DIR=~/.cache/grype/db
SYFT_OPTS=--quiet

# ============================================================================
# Testing
# ============================================================================
PLAYWRIGHT_WORKERS=2
GRID_URL=
PREVIEW_TTL_MIN=60

# ============================================================================
# Feature Flags / Misc
# ============================================================================
FEATURE_FLAG_SDK_KEY=dev-flags
LICENSE_ALLOWLIST=MIT,Apache-2.0,BSD-3-Clause
EMBEDDING_PROVIDER=mock
CDN_PROVIDER=local

# ============================================================================
# Service-Specific
# ============================================================================
# projects-service
SERVICE_NAME_PROJECTS=projects-service
SERVICE_PORT_PROJECTS=7002

# observability-service
SERVICE_NAME_OBSERVABILITY=observability-service
SERVICE_PORT_OBSERVABILITY=7301
ALERT_EMAIL_FROM=alerts@lma.local
SLO_BUDGETS_JSON={}
PAGERDUTY_ROUTING_KEY=

# notification-service
SERVICE_NAME_NOTIFICATION=notification-service
SERVICE_PORT_NOTIFICATION=7902

# dep-governance-service
SERVICE_NAME_DEP_GOVERNANCE=dep-governance-service
SERVICE_PORT_DEP_GOVERNANCE=7106

# db-guardian-service
SERVICE_NAME_DB_GUARDIAN=db-guardian-service
SERVICE_PORT_DB_GUARDIAN=7105
PG_SUPER_DSN=postgres://postgres:postgres@localhost:55432/postgres

# test-lab-service
SERVICE_NAME_TEST_LAB=test-lab-service
SERVICE_PORT_TEST_LAB=7202

# secrets-env-service
SERVICE_NAME_SECRETS_ENV=secrets-env-service
SERVICE_PORT_SECRETS_ENV=7104
