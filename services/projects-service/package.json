{
  "name": "projects-service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "ci:test": "vitest run",
    "ci:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "kill:watchers": "bash ./scripts/kill-watchers.sh",
    "migrate": "tsx src/db/migrations/migrate.ts",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.2",
    "@fastify/helmet": "^11.1.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/resources": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/semantic-conventions": "^1.26.0",
    "fastify": "4.27.0",
    "jose": "^5.2.3",
    "jsonwebtoken": "^9.0.2",
    "nats": "^2.25.0",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@testcontainers/postgresql": "^11.8.0",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.11.2",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.1.0",
    "pino-pretty": "^10.3.1",
    "supertest": "^6.3.3",
    "testcontainers": "^11.8.0",
    "ts-node": "^10.9.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "^1.1.0"
  }
}
