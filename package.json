{
  "name": "lma",
  "private": true,
  "packageManager": "bun@1.0.0",
  "workspaces": [
    "frontends/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "quality:check": "cd services/projects-service && bun run quality:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "husky": "9.1.6",
    "lint-staged": "15.2.9",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "turbo": "2.2.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix --max-warnings=0"
  }
}
