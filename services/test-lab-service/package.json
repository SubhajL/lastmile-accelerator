{
  "name": "test-lab-service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "test:typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint --max-warnings=0 \"src/**/*.{ts,tsx}\" --rule '@typescript-eslint/no-explicit-any: off' --rule '@typescript-eslint/no-unused-vars: off' --rule 'no-empty: off' --rule '@typescript-eslint/ban-ts-comment: off'"
  },
  "dependencies": {
    "jose": "^5.2.4",
    "fastify": "4.27.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/cors": "^8.4.2",
    "@fastify/jwt": "^8.0.0",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "nats": "^2.25.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "zod": "^3.22.4",
    "uuid": "^9.0.1",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/sdk-node": "^0.49.1",
    "@opentelemetry/auto-instrumentations-node": "^0.42.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.49.1",
    "@opentelemetry/resources": "^1.22.0",
    "@opentelemetry/semantic-conventions": "^1.22.0",
    "@opentelemetry/instrumentation-fastify": "^0.35.0",
    "@opentelemetry/instrumentation-http": "^0.49.1",
    "@opentelemetry/instrumentation-pg": "^0.40.0",
    "@opentelemetry/instrumentation-redis-4": "^0.38.0",
    "prom-client": "^15.1.0",
    "@aws-sdk/client-s3": "^3.676.0",
    "@kubernetes/client-node": "^1.0.0",
    "selenium-webdriver": "^4.25.0"
  },
  "devDependencies": {
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "@types/node": "^20.10.6",
    "@types/pg": "^8.11.2",
    "vitest": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "@vitest/coverage-v8": "^1.1.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2",
    "ts-node": "^10.9.2",
    "jsonwebtoken": "^9.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "pg-mem": "^3.0.5",
    "@opentelemetry/sdk-trace-base": "^1.22.0",
    "@opentelemetry/context-async-hooks": "^1.22.0"
  }
}
