# LMA Development Procfile
# Run with: hivemind (in this directory)
# Each process gets hot-reload for instant feedback

# Node.js services (using tsx watch for hot-reload)
projects:       cd ../services/projects-service && SERVICE_PORT=7002 SERVICE_NAME=projects-service pnpm dev
notification:   cd ../services/notification-service && SERVICE_PORT=7902 SERVICE_NAME=notification-service pnpm dev
testlab:        cd ../services/test-lab-service && SERVICE_PORT=7202 SERVICE_NAME=test-lab-service pnpm dev

# Go services (using air for hot-reload)
observability:  cd ../services/observability-service && SERVICE_PORT=7301 SERVICE_NAME=observability-service air -c ../../dev/hot-reload-configs/.air.toml
dbguardian:     cd ../services/db-guardian-service && SERVICE_PORT=7105 SERVICE_NAME=db-guardian-service air -c ../../dev/hot-reload-configs/.air.toml
secretsenv:     cd ../services/secrets-env-service && SERVICE_PORT=7104 SERVICE_NAME=secrets-env-service air -c ../../dev/hot-reload-configs/.air.toml

# Rust service (using cargo-watch for hot-reload)
depgov:         cd ../services/dep-governance-service && cargo watch -x 'run' -w src
