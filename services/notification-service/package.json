{
  "name": "notification-service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "WORKER_MODE=true tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "worker": "WORKER_MODE=true node --enable-source-maps dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "quality:check": "bun run typecheck && bun run lint && bun run test:typecheck"
  },
  "dependencies": {
    "fastify": "4.27.0",
    "fastify-plugin": "^4.5.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^7.2.4",
    "@opentelemetry/sdk-node": "^0.45.1",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/instrumentation-fastify": "^0.31.0",
    "@opentelemetry/instrumentation-http": "^0.45.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.45.1",
    "@opentelemetry/resources": "^1.18.1",
    "@opentelemetry/semantic-conventions": "^1.18.1",
    "nats": "^2.19.0",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "nodemailer": "^6.9.7",
    "handlebars": "^4.7.8",
    "node-vault": "^0.10.2"
  },
  "devDependencies": {
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "^1.0.4",
    "@vitest/coverage-v8": "^1.0.4",
    "@types/node": "^20.10.4",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.9"
  }
}
