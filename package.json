{
  "name": "lma",
  "private": true,
  "packageManager": "bun@1.0.0",
  "workspaces": [
    "frontends/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "quality:check": "bunx turbo run typecheck lint --concurrency=50% && node scripts/check-any-budget.mjs && bunx turbo run test:typecheck --concurrency=50%",
    "openapi:export": "cargo run --manifest-path services/dep-governance-service/Cargo.toml --bin openapi_export",
    "openapi:lint": "bunx @redocly/openapi-cli@latest lint services/dep-governance-service/openapi.yaml",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.10",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "turbo": "2.2.3"
  }
}
